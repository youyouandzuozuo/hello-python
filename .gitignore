# 虚拟环境
.venv/
venv/
env/

# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 打包/分发
build/
dist/
*.egg-info/
.installed.cfg

# 环境变量与密钥（绝不上传）
.env
.env.*
*.pem
*.key
# 但模板文件要留着，方便以后换机器照着填
!.env.example
!example.env

# 编辑器
.vscode/
.idea/
*.swp

# 系统
Thumbs.db
desktop.ini
.DS_Store

# 自检脚本的输出
env-result.txt

# NVIDIA 驱动偶尔会在当前目录吐个日志文件夹，跟学习无关
NVIDIA Corporation/

# 密钥明文，绝不进仓库（token/key 一律不落地，用完即吊销）
密钥.txt
